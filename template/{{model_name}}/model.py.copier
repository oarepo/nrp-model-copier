from oarepo_model.customizations.high_level.set_permission_policy import SetPermissionPolicy


class {{ model_name|to_python_class }}PermissionPolicy(RecordPermissionPolicy):
    """Custom permission policy for {{model_name}}."""

    can_view_deposit_page = [AuthenticatedUser()]


{{model_name}}_model = model(
    "{{model_name}}",
    version="1.0.0",
    presets=[records_resources_preset, drafts_preset, rdm_preset, ui_links_preset],
    types=[
        from_yaml("metadata.yaml", __file__)
    ],
    metadata_type="Metadata",
    customizations=[
