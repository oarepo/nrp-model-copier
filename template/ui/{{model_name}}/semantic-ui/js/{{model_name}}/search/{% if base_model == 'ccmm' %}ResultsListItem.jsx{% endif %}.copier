import React from "react";
import PropTypes from "prop-types";
import _get from "lodash/get";
import { Item, Label, Icon } from "semantic-ui-react";
import { i18next } from "@translations/i18next";

const SearchItemCreators = ({ creators, othersLink }) => {
  const slicedCreators = creators.slice(0, 3);
  const hasMoreCreators = creators.length > 3;

  return (
    <span className="creatibutors">
      {slicedCreators.map((creator, index) => (
        <span key={creator.person_or_org?.name || index}>
          {creator.person_or_org?.name}
          {index < slicedCreators.length - 1 && "; "}
        </span>
      ))}
      {hasMoreCreators && (
        <a href={othersLink}>
          {" "}
          {i18next.t("and {{count}} more", {
            count: creators.length - 3,
          })}
        </a>
      )}
    </span>
  );
};

SearchItemCreators.propTypes = {
  creators: PropTypes.array.isRequired,
  othersLink: PropTypes.string.isRequired,
};

export const ResultsListItem = ({ result, ...rest }) => {
  const accessStatusId = _get(result, "ui.access_status.id", "open");
  const accessStatus = _get(result, "ui.access_status.title_l10n", "Open");
  const accessStatusIcon = _get(result, "ui.access_status.icon", "unlock");
  const createdDate = _get(
    result,
    "ui.created_date_l10n_long",
    i18next.t("No creation date found.")
  );

  const creators = _get(result, "ui.creators.creators", []);
  const descriptionStripped = _get(
    result,
    "ui.description_stripped",
    i18next.t("No description")
  );

  const publicationDate = _get(
    result,
    "ui.publication_date_l10n_long",
    i18next.t("No publication date found.")
  );
  const resourceType = _get(
    result,
    "ui.resource_type.title_l10n",
    i18next.t("No resource type")
  );
  const subjects = _get(result, "ui.subjects", []);
  const title = _get(result, "metadata.title", i18next.t("No title"));
  const version = _get(result, "ui.version", null);

  const viewLink = result.links.self_html;

  return (
    <Item key={result.id} data-testid="result-item">
      <Item.Content>
        <Item.Extra className="labels-actions">
          <Label horizontal size="small" className="primary">
            {publicationDate} ({version})
          </Label>
          <Label horizontal size="small" className="neutral">
            {resourceType}
          </Label>
          <Label horizontal size="small" className={`access-status ${accessStatusId}`}>
            {accessStatusIcon && <Icon name={accessStatusIcon} />}
            {accessStatus}
          </Label>
        </Item.Extra>
        <Item.Header as="h2">
          <a href={viewLink}>{title}</a>
        </Item.Header>
        <Item className="creatibutors">
          <SearchItemCreators creators={creators} othersLink={viewLink} />
        </Item>
        <Item.Description className="truncate-lines-2">
          {descriptionStripped}
        </Item.Description>
        <Item.Extra>
          {subjects.map((subject) => (
            <Label key={subject.title_l10n} size="tiny">
              {subject.title_l10n}
            </Label>
          ))}
          <div className="flex justify-space-between align-items-end">
            <small>
              <p>
                {createdDate && (
                  <>
                    {i18next.t("Uploaded on {{uploadDate}}", {
                      uploadDate: createdDate,
                    })}
                  </>
                )}
              </p>
            </small>
          </div>
        </Item.Extra>
      </Item.Content>
    </Item>
  );
};

ResultsListItem.propTypes = {
  result: PropTypes.object.isRequired,
};

export default ResultsListItem;
