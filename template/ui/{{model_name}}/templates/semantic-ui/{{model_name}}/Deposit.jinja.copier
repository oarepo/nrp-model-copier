{% raw %}
{#def record, form_config #}

{% extends "oarepo_ui/form.html" %}

{%- block javascript %}
    {{ super() }}
    {{ webpack['{% endraw %}{{model_name}}{% raw %}_deposit_form.js'] }}
{%- endblock %}

{%- block page_body %}
    <DepositForm record={{ record }} forms_config={{ form_config }}></DepositForm>
{% endblock page_body %}
{% endraw %}